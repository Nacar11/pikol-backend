# --- App ---
APP_NAME=pikol
DEBUG=true

# --- Database ---
# LOCAL: the docker-compose Postgres, published on host port 5433 to
# avoid colliding with another project already bound to 5432.
# SUPABASE: use the SESSION pooler on port 5432, never the transaction
# pooler on 6543 — asyncpg uses prepared statements and 6543 does not
# support them, which fails intermittently under load only in production.
DATABASE_URL=postgresql+asyncpg://pikol:pikol@localhost:5433/pikol

# --- CORS ---
# Exact origins, JSON array, NO trailing slash (boot fails if you add one).
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Auth ---
# HS256 signing key, at least 32 characters. Generate: openssl rand -hex 32
# Never reuse the development value in production.
JWT_SECRET=change-me-to-the-output-of-openssl-rand-hex-32

# --- Email links ---
FRONTEND_BASE_URL=http://localhost:3000
# console = print emails to the log (development)
EMAIL_PROVIDER=console

# --- Payments ---
# Only "mock" exists until the Maya adapter lands (ADR 0002).
PAYMENT_PROVIDER=mock
API_BASE_URL=http://localhost:8000
# Mounts the mock checkout page. NEVER true on a public deploy.
MOCK_CHECKOUT_ENABLED=true
